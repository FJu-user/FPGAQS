
set_pin_assignment	{ I_sys_clk }			{ LOCATION = C4; IOSTANDARD  = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_mode_sw4 }			{ LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }

set_pin_assignment	{ O_cam_scl }		{ LOCATION = K3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }		{ LOCATION = J3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_24m }	{ LOCATION = L3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_rst }		{ LOCATION = L2; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# HX1P35A board pushbuttons are active-low: KEY3=B9, KEY4=C7.
set_pin_assignment	{ I_button[0] }			{ LOCATION = B9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_button[1] }			{ LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

set_pin_assignment	{ O_tmds_ch0_p }		{ LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch1_p }		{ LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch2_p }		{ LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_clk_p }		{ LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }



# KEY2 mosaic block size (active-low).
set_pin_assignment { I_button[2] } { LOCATION = A9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# UART image input and KEY1 source selection.
set_pin_assignment { I_button[3] } { LOCATION = D5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { I_uart_rx } { LOCATION = J1; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { O_uart_tx } { LOCATION = H1; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# HX1P35 official RGMII pin locations. TXC now uses PLL C1 (+90 degrees),
# so do NOT also retain the zero-phase demo's OUTDEL=3 clock-pad delay.
# Omit OUTDEL to leave the extra delay unrequested; TD rejects OUTDEL=0.
set_pin_assignment { I_a_rgmii_rx_ctl } { LOCATION = N8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_a_rgmii_rxc } { LOCATION = V3; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_a_rgmii_rxd[0] } { LOCATION = N9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_a_rgmii_rxd[1] } { LOCATION = T7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_a_rgmii_rxd[2] } { LOCATION = T8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { I_a_rgmii_rxd[3] } { LOCATION = T9; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { O_a_rgmii_tx_ctl } { LOCATION = R10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; }
set_pin_assignment { O_a_rgmii_txc } { LOCATION = U9; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; }
set_pin_assignment { O_a_rgmii_txd[0] } { LOCATION = R11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; }
set_pin_assignment { O_a_rgmii_txd[1] } { LOCATION = P11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; }
set_pin_assignment { O_a_rgmii_txd[2] } { LOCATION = T10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; }
set_pin_assignment { O_a_rgmii_txd[3] } { LOCATION = R12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; }
set_pin_assignment { O_phy_rst } { LOCATION = V8; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 16; PULLTYPE = NONE; }

# SW2 peer-preview override; KEY1 retains legacy CAMERA/IMAGE selection.
set_pin_assignment { I_cascade_sw2 } { LOCATION = B4; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
